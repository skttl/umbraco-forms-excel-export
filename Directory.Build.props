<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UmbracoFormsMajor Condition="'$(UmbracoFormsMajor)' == ''">18</UmbracoFormsMajor>
    <UmbracoFormsVersion Condition="'$(UmbracoFormsMajor)' == '17'">17.0.0</UmbracoFormsVersion>
    <UmbracoFormsVersion Condition="'$(UmbracoFormsMajor)' == '18'">18.0.0</UmbracoFormsVersion>
    <ContinuousIntegrationBuild Condition="'$(ContinuousIntegrationBuild)' == ''">false</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <RepositoryUrl>https://github.com/skttl/umbraco-forms-excel-export</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Authors>Søren Kottal</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageTags>umbraco;umbraco-forms;umbraco-marketplace;excel;xlsx;export</PackageTags>
    <PackageReleaseNotes>See the GitHub release notes.</PackageReleaseNotes>
  </PropertyGroup>
</Project>
